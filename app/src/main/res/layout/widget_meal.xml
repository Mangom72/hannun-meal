<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/widget_school" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_title" android:textStyle="bold" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingTop="4dp" />
        <TextView android:id="@+id/widget_eating" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_accent" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:id="@+id/widget_actions" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="24sp" android:textColor="@color/widget_accent" android:contentDescription="@string/previous_meal" />
            <TextView android:id="@+id/widget_auto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="자동" android:textSize="12sp" android:textColor="@color/widget_accent" android:contentDescription="@string/automatic_mode" />
            <TextView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="24sp" android:textColor="@color/widget_accent" android:contentDescription="@string/next_meal" />
            <TextView android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textSize="20sp" android:textColor="@color/widget_accent" android:contentDescription="@string/refresh_meals" />
            <TextView android:id="@+id/widget_settings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="설정" android:textSize="12sp" android:textColor="@color/widget_accent" android:contentDescription="@string/widget_settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
