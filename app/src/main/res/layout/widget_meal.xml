<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="@color/widget_title" android:textStyle="bold" android:textSize="14sp" android:maxLines="3" android:ellipsize="end" />
            <Button android:id="@+id/widget_refresh" style="?android:attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:minHeight="48dp" android:padding="0dp" android:background="@android:color/transparent" android:gravity="center" android:includeFontPadding="false" android:text="↻" android:textAllCaps="false" android:textSize="24dp" android:textColor="@color/widget_accent" android:contentDescription="@string/refresh_meals" />
        </LinearLayout>
        <TextView android:id="@+id/widget_school" android:layout_width="match_parent" android:layout_height="16dp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
        <TextView android:id="@+id/widget_eating" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="16dp" android:includeFontPadding="false" android:textColor="@color/widget_accent" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="16dp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
